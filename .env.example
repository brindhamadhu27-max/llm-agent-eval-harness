# Copy to .env and `export $(cat .env | xargs)` (or set in your shell). Never commit real keys.
EVAL_PROVIDER=mock            # mock | ollama | openai
JUDGE_PROVIDER=               # optional: a DIFFERENT provider/model for the judge

# OpenAI-compatible (OpenAI, Groq, Gemini compat endpoint, Ollama /v1)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=llama-3.1-8b-instant
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
